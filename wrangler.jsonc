{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zahra-proxy",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "2799bca3-b210-4888-a27d-59d78ca9fec6","database_name": "zahra-proxy" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "a39f63392b934e4aa6be688f3421775b" }
  ],
  "vars": {
    "PAGES_URL": "https://nova-panel.github.io"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
